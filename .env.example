# Valores privados: configura estas variables en Vercel y no subas un .env.
# Única conexión Redis para contactos, códigos, cuotas e historial.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Genera un valor aleatorio estable: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
CRON_SECRET=
AIRE_NAMESPACE=cdmx

# Remitentes. Los destinatarios se registran y confirman desde la página.
TELEGRAM_BOT_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Plantilla de aviso: la variable {{1}} recibe el texto completo.
TWILIO_WHATSAPP_CONTENT_SID=
# Plantilla de confirmación opcional: la variable {{1}} recibe solo el código.
TWILIO_WHATSAPP_VERIFY_CONTENT_SID=

# Correo: API key de SendGrid y remitente verificado en SendGrid.
SENDGRID_API_KEY=
EMAIL_FROM=

# Cuotas de intentos compartidas por todo el despliegue, separadas por finalidad.
MAX_MESSAGES_PER_DAY=6
MAX_TEST_MESSAGES_PER_DAY=3
MAX_VERIFICATIONS_PER_DAY=12
MAX_SUBSCRIPTIONS=64
# 1440 corresponde al cron diario incluido; 15 solo al habilitar el programador frecuente.
ALERT_CHECK_MINUTES=1440
ALLOWED_ORIGINS=
