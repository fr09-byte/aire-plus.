# Configura las variables en Vercel; no copies credenciales al HTML.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+17372508034
TWILIO_SMS_TO=
# Usa el remitente aprobado o el número EXACTO de tu Sandbox.
TWILIO_WHATSAPP_FROM=whatsapp:+17372508034
TWILIO_WHATSAPP_TO=
# Opcional: plantilla aprobada, con variable {{1}} para el texto de aviso.
TWILIO_WHATSAPP_CONTENT_SID=

# Redis es necesario para SMS/WhatsApp y para avisos con el sitio cerrado.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MAX_MESSAGES_PER_DAY=6
AIRE_NAMESPACE=cdmx

# Opcional, recomendado: valor aleatorio estable de 32+ caracteres para cookies.
# Sin él se deriva una firma privada de los tokens del proveedor en el servidor.
SESSION_SECRET=
# Solo el cron usa esta credencial; el panel no la pide ni la envía.
CRON_SECRET=
# Solo si necesitas acceder al backend desde otro dominio permitido.
ALLOWED_ORIGINS=
